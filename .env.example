# Aplicação
APP_PORT=3000

# Banco de dados (Postgres existente na rede infra_default)
DATABASE_URL=postgresql://usuario:senha@infra-supabase-db-1:5432/postgres

# Auth.js
AUTH_SECRET=troque-por-um-segredo-forto-com-32-caracteres-minimo
AUTH_TRUST_HOST=true

# N8N
N8N_WEBHOOK_URL=http://infra-n8n-1:5678/webhook/video-pipeline
N8N_API_KEY=

# Arquivos gerados (dentro do container)
OUTPUT_DIR=/app/output

# Infra Docker
# Pasta do host que sera montada em /app/output (deve ser a mesma pasta que o N8N escreve)
OUTPUT_DIR_HOST=./output
# Rede docker onde rodam n8n/postgres (docker network ls)
DOCKER_NETWORK=infra_default
