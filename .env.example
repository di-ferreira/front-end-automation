# Provedor do banco: sqlite | postgres | mysql
DB_PROVIDER=sqlite

# SQLite (padrão para desenvolvimento local, sem Docker)
DATABASE_URL=./data/app.db
# Postgres (ex.: container existente na rede infra_default)
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/postgres
# MySQL / MariaDB
# DATABASE_URL=mysql://usuario:senha@localhost:3306/painel

# Seed inicial (usado por npm run db:seed)
SEED_ADMIN_EMAIL=admin@painel.local
SEED_ADMIN_PASSWORD=trocar123
SEED_ADMIN_NAME=Administrador

# Auth.js
AUTH_SECRET=troque-por-um-segredo-forte-com-32-caracteres-minimo
AUTH_TRUST_HOST=true

# N8N
# Webhook inicial do workflow (deve responder imediatamente)
# Contrato enviado pelo painel: { executionId, prompt }
N8N_WEBHOOK_URL=http://infra-n8n-1:5678/webhook/video-pipeline
# Se definida, enviada como "Authorization: Bearer <chave>" no webhook
N8N_API_KEY=

# Pasta de saída local (assets gerados pelo N8N; em Docker vira /app/output)
OUTPUT_DIR=./output

# --- Somente para Docker (Fase final) ---
APP_PORT=3000
OUTPUT_DIR_HOST=./output
DOCKER_NETWORK=infra_default
