# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.ts text diff=typescript
*.tsx text diff=typescript
*.js text diff=javascript
*.jsx text diff=javascript
*.json text
*.md text diff=markdown
*.css text diff=css
*.html text diff=html
*.yml text
*.yaml text
*.sql text

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary

# Shell scripts
*.sh text eol=lf
Dockerfile text eol=lf

# Keep lock files as-is
package-lock.json -diff
